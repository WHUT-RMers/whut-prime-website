# 复制为 .env 后自行填写。该文件不要提交，也不要把授权码发到聊天记录。
RECRUITMENT_EMAIL_VERIFICATION_ENABLED=1
QQ_SMTP_USER=你的QQ邮箱@qq.com
QQ_SMTP_AUTH_CODE=在QQ邮箱生成的SMTP授权码
DEFAULT_FROM_EMAIL=PRIME 招新 <你的QQ邮箱@qq.com>
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
# 秀米同步应用：先在秀米同步应用控制台创建并审核通过，再填写到服务器环境变量。
# Secret 只放服务器，不要写进前端、截图或聊天记录。
# XIUMI_APP_ID=你的秀米AppID
# XIUMI_APP_SECRET=你的秀米Secret
# XIUMI_BIND_NAME=WHUT PRIME 官网
# 文档原样预览引擎：auto 会按 WPS → LibreOffice → Microsoft Office 自动选择。
# 浏览器端不需要安装这些软件；它们只需要安装在运行 Django 的服务器上。
PRIME_DOCUMENT_RENDERER=auto
# 如软件不在默认安装目录，可填写完整路径：
# PRIME_WPS_EXECUTABLE=C:\\Program Files\\Kingsoft\\WPS Office\\office6\\wps.exe
# PRIME_LIBREOFFICE_EXECUTABLE=C:\\Program Files\\LibreOffice\\program\\soffice.exe
